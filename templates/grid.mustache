{{!
    @template mod_competencygrid/grid

    TODO describe template grid

    Example context (json):
    {
    }
}}
<style>
    :root {
        --defaulttextcolor: {{settingsinfo.defaulttextcolor}};
        --secondarytextcolor: {{settingsinfo.secondarytextcolor}};
        --previouslyselectedcolor: {{settingsinfo.previouslyselectedcolor}};
        --currentselectioncolor: {{settingsinfo.currentselectioncolor}};
    }
    .hidden-radio:checked + .clickable-label {
        background-color: var(--currentselectioncolor);
    }
    .hidden-radio:checked + .clickable-label .cell-content {
        color: var(--secondarytextcolor);
    }
    .selected-cell {
        background-color:var(--previouslyselectedcolor);
    }
    .cell-content {
        white-space: pre-wrap;
        color:var(--defaulttextcolor);
    }
</style>
<br>
<br>
<h3>{{qualification_title}}</h3>
<br>
<form action="" method="post">
<table id="skill-{{skill_index}}" class="grid-table">
    <thead>
        <tr>
            {{#table_header}}
            <th>{{.}}</th>
            {{/table_header}}
        </tr>
    </thead>
    <tbody>
        {{#subskills}}
        <tr>
            <td>
                <span><strong>{{name}}</strong></span>
            </td>
            {{#level_descriptions}}
                <td class="{{#previouslyselected}}selected-cell{{/previouslyselected}}" >
                    <input type="radio" class="hidden-radio" id="radio-{{skill_index}}-{{subskill_id}}-{{level_id}}" name="userinput[{{subskill_id}}]" value="{{level_id}}">
                    <label class="clickable-label" for="radio-{{skill_index}}-{{subskill_id}}-{{level_id}}">
                        <span class="cell-content">{{description}}</span>
                    </label>
                </td>
            {{/level_descriptions}}
        </tr>
        {{/subskills}}
    </tbody>
</table>
<br>
<button class="btn btn-primary" type="submit" name="submit">Submit</button>
</form>
