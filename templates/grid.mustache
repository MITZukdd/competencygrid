{{!
    @template mod_competencygrid/grid

    TODO describe template grid

    Example context (json):
    {
    }
}}

{{#visibility}}
<div class="section-item">
    <form action="" method="post">
        <input type="hidden" name="sesskey" value="{{config.sesskey}}">
        <table id="skill-{{skillid}}" class="table table-borderless grid-table">
            <thead>
                <tr>
                    {{#tableheader}}
                    <th  style="hyphens: auto"><span class="m-1">{{.}}</span></th>
                    {{/tableheader}}
                </tr>
            </thead>
            <tbody>
                {{#subskills}}
                {{#visibility}}
                <tr>
                    <td class="p-1">
                        <p style="hyphens: auto" ><strong>{{name}}</strong></p>
                            {{#courses}}
                                <p style="hyphens: auto"><a href="{{viewurl}}">{{fullname}}</a></p>
                            {{/courses}}
                    </td>
                    {{#leveldescriptions}}
                        <td class=" rounded-2" data-title="{{leveltitle}}">
                            <input type="radio" class="hidden-radio" id="radio-{{skillid}}-{{subskillid}}-{{levelniveau}}" name="userinput[{{subskillid}}]" value="{{levelniveau}}">
                            <label class=" border {{#previouslyselected}}selected-cell{{/previouslyselected}} clickable-label rounded-2 p-2" for="radio-{{skillid}}-{{subskillid}}-{{levelniveau}}">
                                <span class="cell-content" style="hyphens: auto">{{description}}</span>
                            </label>
                        </td>
                    {{/leveldescriptions}}
                </tr>
                {{/visibility}}
                {{/subskills}}
            </tbody>
        </table>
        <button class="btn btn-primary my-3" type="submit" name="submit">{{#str}} submit {{/str}}</button>
    </form>
</div>
{{/visibility}}