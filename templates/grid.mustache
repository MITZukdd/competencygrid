{{!
    @template mod_competencygrid/grid

    TODO describe template grid

    Example context (json):
    {
    }
}}
<style>
    :root {
        --defaulttextcolor: {{settingsinfo.defaulttextcolor}};
        --secondarytextcolor: {{settingsinfo.secondarytextcolor}};
        --previouslyselectedcolor: {{settingsinfo.previouslyselectedcolor}};
        --currentselectioncolor: {{settingsinfo.currentselectioncolor}};
    }
    .hidden-radio:checked + .clickable-label {
        background-color: var(--currentselectioncolor);
    }
    .hidden-radio:checked + .clickable-label .cell-content {
        color: var(--secondarytextcolor);
    }
    .cell-content {
        white-space: pre-wrap;
        color:var(--defaulttextcolor);
    }
</style>

{{#visibility}}
<div class="section-item">
    <form action="" method="post">
        <input type="hidden" name="sesskey" value="{{config.sesskey}}">
        <table id="skill-{{skill_index}}" class="table grid-table">
            <thead>
                <tr>
                    {{#table_header}}
                    <th  style="hyphens: auto"><span class="m-1">{{.}}</span></th>
                    {{/table_header}}
                </tr>
            </thead>
            <tbody>
                {{#subskills}}
                {{#visibility}}
                <tr>
                    <td class="p-1">
                        <p style="hyphens: auto" ><strong>{{name}}</strong></p>
                            {{#courses}}
                                <p style="hyphens: auto"><a href="{{viewurl}}">{{fullname}}</a></p>
                            {{/courses}}
                    </td>
                    {{#level_descriptions}}
                        <td class=" rounded-2" style="height: 1px">
                            <input type="radio" class="hidden-radio" id="radio-{{skill_index}}-{{subskill_id}}-{{level_id}}" name="userinput[{{subskill_id}}]" value="{{level_id}}">
                            <label class="{{#previouslyselected}}selected-cell{{/previouslyselected}} clickable-label rounded-2 p-2" for="radio-{{skill_index}}-{{subskill_id}}-{{level_id}}">
                                <span class="cell-content" style="hyphens: auto">{{description}}</span>
                            </label>
                        </td>
                    {{/level_descriptions}}
                </tr>
                {{/visibility}}
                {{/subskills}}
            </tbody>
        </table>
        <button class="btn btn-primary my-3" type="submit" name="submit">{{#str}} submit {{/str}}</button>
    </form>
</div>
{{/visibility}}