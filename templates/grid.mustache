{{!
    @template mod_competencygrid/grid

    TODO describe template grid

    Example context (json):
    {
    }
}}

<table border="1" class="grid-table">
    <thead>
        <tr>
            {{#header}}
            <th>{{.}}</th>
            {{/header}}
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            {{#cells}}
            <td>
                <input type="checkbox" class="hidden-checkbox" id="checkbox-{{row_index}}-{{cell_index}}">
                <label class="clickable-label" for="checkbox-{{row_index}}-{{cell_index}}">
                    <span class="cell-content">{{value}}</span>
                </label>
            </td>
            {{/cells}}
        </tr>
        {{/rows}}
    </tbody>
</table>
