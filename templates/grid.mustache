{{!
    @template mod_competencygrid/grid

    TODO describe template grid

    Example context (json):
    {
    }
}}

<br>
<br>
<h3>{{qualification_title}}</h3>
<br>
<form action="" method="post">
<table id="skill-{{skill_index}}" class="grid-table">
    <thead>
        <tr>
            {{#table_header}}
            <th>{{.}}</th>
            {{/table_header}}
        </tr>
    </thead>
    <tbody>
        {{#subskills}}
        <tr>
            <td>
                <span>{{name}}</span>
            </td>
            {{#level_descriptions}} <!-- Loop through level descriptions for each subskill -->
                <td>
                    <input type="radio" class="hidden-radio" id="radio-{{skill_index}}-{{subskill_id}}-{{level_id}}" name="radio-group-{{skill_index}}-{{subskill_id}}">
                    <label class="clickable-label" for="radio-{{skill_index}}-{{subskill_id}}-{{level_id}}">
                        <span class="cell-content">{{description}}</span>
                    </label>
                </td>
            {{/level_descriptions}}
        </tr>
        {{/subskills}}
    </tbody>
</table>
<br>
<button class="btn btn-primary" type="submit">Submit</button>
</form>
