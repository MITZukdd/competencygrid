{{!
    @template mod_competencygrid/fit

    TODO describe template fit

    Example context (json):
    {
    }
}}

<div style="display: grid;
    grid-template-columns: max-content fit-content(25%) 1fr max-content;
    gap: 0.5rem;
    align-items: center;
    row-gap: 2px;
    margin: 1rem 0;">


    <span class="h2">
        {{#sufficient}}<i class="fa-regular fa-circle-check green text-success"></i>{{/sufficient}}
        {{^sufficient}}<i class="icon fa-regular fa-circle-xmark text-danger" ></i>{{/sufficient}}
    </span>


    <span>{{#str}}total_progress, mod_competencygrid{{/str}}</span>
    <div class="progress">
        <div class="progress-bar rounded"
             role="progressbar"
             style="width: {{progress}}%; background-color: {{color}};"
             aria-valuenow="{{progress}}"
             aria-valuemin="0"
             aria-valuemax="{{max}}">
        </div>
    </div>
    {{value}}/{{max}}

    {{#skills}}

        <h3 class="mt-3 mb-3" style="grid-column: 1 / -1;">{{skillname}}</h3>
        <span class="fs-3 d-flex justify-content-center">
            {{#sufficient}}<i class="fa-regular fa-circle-check text-success mt-1 mb-2"></i>{{/sufficient}}
            {{^sufficient}}<i class="fa-regular fa-circle-xmark text-danger mt-1 mb-2"></i>{{/sufficient}}</span>
        <span class= "text-wrap fw-bold">
            {{#str}} progress, mod_competencygrid{{/str}}
        </span>
        <div class="progress">
            <div class="progress-bar rounded"
                 role="progressbar"
                 style="width: {{progress}}%; background-color: {{color}};"
                 aria-valuenow="{{progress}}"
                 aria-valuemin="0"
                 aria-valuemax="{{max}}">
            </div>
        </div>
        {{value}}/{{max}}


        {{#subskills}}
            <span class="d-flex justify-content-center">
                {{#sufficient}}
                    <i class="fa-regular fa-circle-check text-success"></i>
                {{/sufficient}}
                {{^sufficient}}
                    <i class="fa-regular fa-circle-xmark text-danger"></i>
                {{/sufficient}}
            </span>

            {{#hascourses}}
                <div>
                    <span>
                        <a class="text-wrap" data-bs-toggle="collapse" href="#{{subskillid}}" role="button" aria-expanded="false" aria-controls="{{subskillid}}">
                            <i class="fa-solid fa-chevron-right chevron-toggle"></i> {{subskillname}}
                        </a>
                    </span>
                    <div class="collapse" id="{{subskillid}}">
                        {{#courses}}
                            <span><a href="{{viewurl}}">{{fullname}}</a></span><br>
                        {{/courses}}
                    </div>
                </div>
            {{/hascourses}}
            {{^hascourses}}
                <span>
                    {{subskillname}}
                </span>
            {{/hascourses}}
            <div class="progress">
                <div class="progress-bar rounded"
                     role="progressbar"
                     style="width: {{progress}}%; background-color: {{color}};"
                     aria-valuenow="{{progress}}"
                     aria-valuemin="0"
                     aria-valuemax="{{max}}">
                </div>
            </div>
            {{value}}/{{max}}
        {{/subskills}}
    {{/skills}}


</div>
