{{!
    @template mod_competencygrid/analysis

    TODO describe template analysis

    Example context (json):
    {
    }
}}

{{#skills}}
    <div class="visually-hidden">
        <script type="application/json" id="chart-data-{{skillid}}">{{{chartdatajson}}}</script>
    </div>
{{/skills}}

{{#skills-historic}}
    <div class = "visually-hidden">
        <script type="application/json" id="chart-data-{{skillid}}-historic">{{{chartdatajson}}}</script>
    </div>
{{/skills-historic}}

<div class = "d-flex justify-content-evenly">
    <div>
        <ul class="nav nav-pills mb-3 mt-3" id="chartTab" role="tablist">
            {{#tabs}}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {{#active}}active{{/active}}" id="{{id}}-tab" data-bs-toggle="tab" data-bs-target="#{{id}}" type="button" role="tab"
                            aria-controls="{{id}}"
                            aria-selected="{{active}}">{{label}}</button>
                </li>
            {{/tabs}}
        </ul>

        <div class="tab-content" id="chartTabContent">
            {{#tabs}}
                <div class="tab-pane fade {{#active}}show active{{/active}}" id="{{id}}" role="tabpanel" aria-labelledby="{{id}}-tab">
                    {{#skills}}
                        <h4>{{skilltitle}}</h4>
                        <div class="competencygrid-chart-block d-flex align-items-start">
                            <div class="chart-container position-relative" style="height:50vh; width:35vw">
                                <canvas id="{{id}}-{{skillid}}"></canvas>
                            </div>
                        </div>
                        <br>
                    {{/skills}}
                </div>
            {{/tabs}}
        </div>
    </div>

    <div>
        <ul class="nav nav-pills mb-3 mt-3" id="chartTab" role="tablist">
            {{#tabs-historic}}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {{#active}}active{{/active}}" id="{{id}}-tab" data-bs-toggle="tab" data-bs-target="#{{id}}" type="button" role="tab"
                            aria-controls="{{id}}"
                            aria-selected="{{active}}">{{label}}</button>
                </li>
            {{/tabs-historic}}
        </ul>

        <div class="tab-content" id="chartTabContentHistoric">
            {{#tabs-historic}}
                <div class="tab-pane fade {{#active}}show active{{/active}}" id="{{id}}" role="tabpanel" aria-labelledby="{{id}}-tab">
                    {{#skills}}
                        <h4 style="opacity: 0">{{skilltitle}}</h4>
                        <div style="height:50vh;width:35vw">
                            <canvas id="skill-{{id}}-{{skillid}}"></canvas>
                        </div>
                        <br>
                    {{/skills}}
                </div>
            {{/tabs-historic}}
        </div>
    </div>
</div>